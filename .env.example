# Copy to .env (gitignored). You only need the key(s) for the provider(s) you use.

# Claude API (provider: claude_api). Not needed with claude_cli (subscription).
ANTHROPIC_API_KEY=

# OpenAI-compatible gateway (provider: openai_compat) — only if it requires a token.
OPENAI_COMPAT_API_KEY=

# Ollama (provider: ollama) needs no key.
